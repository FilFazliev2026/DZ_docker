
FROM node:20-alpine

# устанавливаем директорию внутри контейнера, где будут выполняться все команды
WORKDIR /app

# копируем файлы из папки в директорию контейнера
COPY front.html forfront.js ./

# устанавливаем порт
EXPOSE 8098

# запуск веб-сервера через Node.js при запуске
CMD ["node", "forfront.js"]