FROM python:3.11-alpine

# устанавливаем директорию внутри контейнера, где будут выполняться все команды
WORKDIR /app

# копируем main.py в контейнер
COPY main.py .

# запуск контейнера при запуске
# "-u"  отключает буферизацию потока вывода, чтобы всё выводилось сразу
CMD ["python", "-u", "main.py"]